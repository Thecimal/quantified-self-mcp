{
  "name": "quantified-self-mcp-node",
  "version": "0.3.0",
  "description": "MCP server (Node/TypeScript port) giving an LLM local, read/write access to your own health data: daily metrics, raw measurements with source provenance, and analytics (baselines, anomaly detection, trend, correlation). Ported from the Python original by Thecimal.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "quantified-self-mcp": "dist/server.js",
    "quantified-self-init-db": "dist/init-db.js"
  },
  "files": [
    "dist",
    "sample_data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "init-db": "node dist/init-db.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "health",
    "quantified-self",
    "sqlite",
    "local-first",
    "claude",
    "apple-health",
    "health-connect"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "sax": "^1.6.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/sax": "^1.2.7",
    "typescript": "^7.0.2"
  }
}
