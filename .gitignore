# Personal data — never commit this
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build artifacts — built by .github/workflows/publish.yml on release tags,
# never meant to be committed (they'd immediately go stale)
dist/
build/

# Patch & temporary debug files
*.patch
*.log
*errors.txt

# OS
.DS_Store
Thumbs.db

