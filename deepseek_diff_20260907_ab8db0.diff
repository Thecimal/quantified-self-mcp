+# Initialize database with metadata table if needed
+def init_metadata_table():
+    """Create metadata table for storing profile and goals if it doesn't exist."""
+    with get_db_connection() as conn:
+        cursor = conn.cursor()
+        cursor.execute("""
+            CREATE TABLE IF NOT EXISTS user_meta (
+                key TEXT PRIMARY KEY,
+                value TEXT,
+                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
+            )
+        """)
+        
+        # Initialize with default profile if empty
+        cursor.execute("SELECT COUNT(*) FROM user_meta WHERE key LIKE 'profile.%'")
+        if cursor.fetchone()[0] == 0:
+            default_profile = DEFAULT_CONFIG["profile"]
+            for key, value in default_profile.items():
+                if value is not None:
+                    cursor.execute(
+                        "INSERT OR IGNORE INTO user_meta (key, value) VALUES (?, ?)",
+                        (f"profile.{key}", str(value) if value is not None else None)
+                    )
+        
+        conn.commit()
+
+
+# Call initialization
+init_metadata_table()
