+@mcp.resource("health://profile")
+def get_profile() -> str:
+    """Get user profile information."""
+    try:
+        # Try to load config from JSON file
+        if os.path.exists(CONFIG_PATH):
+            with open(CONFIG_PATH, 'r') as f:
+                config = json.load(f)
+                profile = config.get("profile", DEFAULT_CONFIG["profile"])
+        else:
+            # Check if profile data exists in database
+            with get_db_connection() as conn:
+                cursor = conn.cursor()
+                cursor.execute("SELECT key, value FROM user_meta WHERE key LIKE 'profile.%'")
+                rows = cursor.fetchall()
+                if rows:
+                    profile = {}
+                    for row in rows:
+                        key = row[0].split('.', 1)[1]
+                        profile[key] = row[1]
+                else:
+                    profile = DEFAULT_CONFIG["profile"]
+        
+        return json.dumps(profile, indent=2)
+    except Exception as e:
+        return json.dumps({"error": f"Failed to retrieve profile: {str(e)}", "profile": DEFAULT_CONFIG["profile"]}, indent=2)
+
+
+@mcp.resource("health://goals")
+def get_goals() -> str:
+    """Get user-defined health goals."""
+    try:
+        # Try to load config from JSON file
+        if os.path.exists(CONFIG_PATH):
+            with open(CONFIG_PATH, 'r') as f:
+                config = json.load(f)
+                goals = config.get("goals", {})
+        else:
+            # Check if goals exist in database
+            with get_db_connection() as conn:
+                cursor = conn.cursor()
+                cursor.execute("SELECT key, value FROM user_meta WHERE key LIKE 'goal.%'")
+                rows = cursor.fetchall()
+                if rows:
+                    goals = {}
+                    for row in rows:
+                        key = row[0].split('.', 1)[1]
+                        try:
+                            goals[key] = float(row[1])
+                        except ValueError:
+                            goals[key] = row[1]
+                else:
+                    # Default goals based on typical health metrics
+                    goals = {
+                        "steps": 10000,
+                        "sleep_hours": 8.0,
+                        "resting_heart_rate": 70,
+                        "workout_minutes": 30,
+                        "water_ml": 2000,
+                        "mood": 8
+                    }
+        
+        return json.dumps(goals, indent=2)
+    except Exception as e:
+        return json.dumps({"error": f"Failed to retrieve goals: {str(e)}"}, indent=2)
+
+
+@mcp.resource("health://summary/month")
+def get_monthly_summary() -> str:
+    """Get a summary of health metrics for the current month."""
+    try:
+        current_date = datetime.now()
+        start_date = current_date.replace(day=1).strftime("%Y-%m-%d")
+        end_date = current_date.strftime("%Y-%m-%d")
+        
+        with get_db_connection() as conn:
+            cursor = conn.cursor()
+            
+            # Get all metrics for the current month
+            cursor.execute("""
+                SELECT date, steps, sleep_hours, resting_heart_rate, 
+                       weight_kg, workout_minutes, mood, water_ml
+                FROM daily_metrics
+                WHERE date >= ? AND date <= ?
+                ORDER BY date
+            """, (start_date, end_date))
+            
+            rows = cursor.fetchall()
+            if not rows:
+                return json.dumps({"error": "No data available for the current month"}, indent=2)
+            
+            # Calculate statistics
+            metrics = {
+                "steps": [],
+                "sleep_hours": [],
+                "resting_heart_rate": [],
+                "weight_kg": [],
+                "workout_minutes": [],
+                "mood": [],
+                "water_ml": []
+            }
+            
+            for row in rows:
+                for i, col in enumerate(["date", "steps", "sleep_hours", "resting_heart_rate", 
+                                         "weight_kg", "workout_minutes", "mood", "water_ml"]):
+                    if i > 0 and row[i] is not None:  # Skip date column
+                        metrics[col].append(row[i])
+            
+            summary = {
+                "month": current_date.strftime("%Y-%m"),
+                "total_days": len(rows),
+                "day_coverage": {
+                    "tracked_days": len(rows),
+                    "total_days_in_month": (current_date.replace(day=28) + timedelta(days=4)).replace(day=1).day
+                },
+                "averages": {},
+                "totals": {},
+                "max_values": {},
+                "min_values": {},
+                "trends": {}
+            }
+            
+            # Calculate averages, totals, min, max for each metric
+            for metric, values in metrics.items():
+                if values:
+                    summary["averages"][metric] = round(sum(values) / len(values), 2)
+                    summary["totals"][metric] = sum(values)
+                    summary["max_values"][metric] = max(values)
+                    summary["min_values"][metric] = min(values)
+                    
+                    # Calculate trend (simple: compare first half vs second half)
+                    mid = len(values) // 2
+                    if mid > 1:
+                        first_half_avg = sum(values[:mid]) / mid
+                        second_half_avg = sum(values[mid:]) / (len(values) - mid)
+                        summary["trends"][metric] = {
+                            "direction": "up" if second_half_avg > first_half_avg else "down",
+                            "change_percent": round(((second_half_avg - first_half_avg) / first_half_avg) * 100, 1)
+                        }
+            
+            return json.dumps(summary, indent=2)
+    except Exception as e:
+        return json.dumps({"error": f"Failed to generate monthly summary: {str(e)}"}, indent=2)
+
